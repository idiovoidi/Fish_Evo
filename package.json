{
    "name": "yuka-babylon-navigation",
    "version": "1.0.0",
    "description": "A navigation simulation using Yuka and Babylon.js",
    "main": "dist/app.js",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "start": "npm run build && npx http-server . -o",
        "debug": "npm run build && npx http-server . -p 5502",
        "dev": "vite",
        "preview": "vite preview"
    },
    "dependencies": {
        "ecsy": "^0.4.3",
        "http-server": "^14.1.1"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "typescript": "^5.9.3",
        "vite": "^5.4.0"
    }
}
